# Client (safe to expose anon key only — never provider API keys in VITE_*)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Dev-only direct provider keys (ignored in production builds)
# Prefer Supabase Edge secrets for: GEMINI_API_KEY, OPENROUTER_API_KEY, GROQ_API_KEY,
# MISTRAL_API_KEY, DEEPSEEK_API_KEY, OPENAI_API_KEY, XAI_API_KEY, ANTHROPIC_API_KEY
# VITE_GEMINI_API_KEY=
