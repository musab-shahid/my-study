{
  "name": "my-study",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/security-headers.mjs --write && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "eslint src --max-warnings 69",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "generate:cgei-index": "tsx scripts/generate-cgei-curriculum-index.ts",
    "snapshot:cgei-question-ids": "tsx scripts/snapshot-cgei-question-ids.ts",
    "lint:cgei-questions": "tsx scripts/lint-cgei-questions.ts",
    "cgei:sync": "tsx scripts/cgei-sync.ts",
    "check:cgei-sync": "node scripts/check-cgei-sync-idempotence.mjs",
    "check:cgei": "npm run check:cgei-sync && npm run report:cgei-units && npm run check:cgei-readiness-transitions && npm run validate:data && npm run check:cgei-core-leaf-evidence && npm run check:cgei-question-id-ledger && npm run check:cgei-index",
    "check:cgei-index": "tsx scripts/check-cgei-curriculum-index.ts",
    "check:cgei-question-id-ledger": "tsx scripts/check-cgei-question-id-ledger.ts",
    "check:cgei-core-leaf-evidence": "tsx scripts/check-cgei-core-leaf-evidence.ts",
    "check:cgei-readiness-transitions": "tsx scripts/check-cgei-readiness-transitions.ts",
    "report:cgei-units": "tsx scripts/report-cgei-unit-readiness.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "check:headers": "npm run check:static-graph && node scripts/security-headers.mjs --check",
    "check:static-graph": "node scripts/check-static-graph.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "check:feature-icons": "node scripts/check-feature-icons.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:readiness-presentation": "tsx scripts/check-readiness-presentation.ts",
    "check:design-system": "node scripts/check-design-system.mjs --ratchet && node scripts/check-design-system.mjs",
    "check:perf-gate": "node scripts/run-lighthouse-ci.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "playwright": "^1.49.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}
