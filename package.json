{
  "name": "examprep-hub",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "dependencies": {
    "katex": "^0.19.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit",
    "validate:data": "tsx --tsconfig tsconfig.app.json scripts/validate-curriculum.ts && tsx scripts/validate-question-bank.ts && tsx --tsconfig tsconfig.app.json scripts/validate-source-traceability.ts && npm run audit:cgei && npm run validate:traceability:all && npm run audit:data-inventory",
    "audit:data-inventory": "tsx --tsconfig tsconfig.app.json scripts/audit-app-data-inventory.ts",
    "check:design-system": "node scripts/check-design-system.mjs",
    "lint": "eslint src --max-warnings 200",
    "check": "npm run validate:data && npm test && npm run typecheck && npm run lint && npm run build",
    "test": "tsx --tsconfig tsconfig.app.json --test src/lib/__tests__/*.test.ts src/router/__tests__/*.test.ts src/__tests__/data/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "audit:core-leaves": "python3 scripts/audit_core_leaf_coverage.py --allow-unmapped",
    "audit:cgei": "tsx --tsconfig tsconfig.app.json scripts/audit-cgei-coverage.ts",
    "audit:core-leaf-evidence": "tsx --tsconfig tsconfig.app.json scripts/audit-core-leaf-evidence.ts",
    "validate:traceability:all": "tsx --tsconfig tsconfig.app.json scripts/validate-all-traceability.ts",
    "audit:full-source": "python3 scripts/audit_full_source_disposition.py",
    "scan:secrets": "python3 scripts/scan_repo_secrets.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.15.0",
    "playwright": "^1.49.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.12"
  }
}
